{
  "functions": {
    "src/app/api/voice/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/agents/health-check",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/agents/usage-report",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/agents/score-alerts",
      "schedule": "*/30 14-22 * * 1-5"
    },
    {
      "path": "/api/agents/update-edge",
      "schedule": "30 20 * * 1-5"
    },
    {
      "path": "/api/agents/learn-from-outcomes",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/agents/analyze-chat",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/gap-outcomes?action=record",
      "schedule": "35 13 * * 1-5"
    },
    {
      "path": "/api/gap-outcomes?action=score",
      "schedule": "5 15 * * 1-5"
    },
    {
      "path": "/api/gap-outcomes?action=eod",
      "schedule": "5 20 * * 1-5"
    }
  ]
}